QDRANT_URL=your_qdrant_url_here
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=your_collection_name_here

# Optional - defaults to intfloat/multilingual-e5-small if not set
EMBEDDING_MODEL=intfloat/multilingual-e5-small

GEMINI_MODEL=your_gemini_model_name_here
GEMINI_API_KEY=your_gemini_api_key_here

GROQ_MODEL=your_groq_model_name_here
GROQ_API_KEY=your_groq_api_key_here

# Number of top results to retrieve, e.g. 5
TOP_K=5
